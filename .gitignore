# Dependencies
node_modules/
package-lock.json

# Downloads
downloads/
*.mp4
*.mp3
*.m4a
*.wav
*.mkv
*.webm

# Credentials — NEVER commit. Export your own and keep it local.
cookies.txt
**/cookies.txt

# Per-user desktop state (settings.json, cookies, self-updated yt-dlp)
# In dev this lives in server/.appdata; packaged builds use the OS user-data dir.
.appdata/
**/.appdata/

# yt-dlp binaries — download at install time, don't commit
yt-dlp
yt-dlp.exe
yt-dlp_linux
yt-dlp_linux_aarch64
yt-dlp_macos

# Environment variables
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build outputs
dist/
# build/ holds electron-builder resources (icons) — track those, ignore output
build/*
!build/icon.png
!build/icon.ico
!build/icons/
!build/icons/**
!build/icns/
!build/icns/**
release/

# Partial downloads / rollback copies from the yt-dlp self-updater
*.download
*.prev

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test files
test-*.js
test-*.html

# Temporary files
*.tmp
*.temp

