{
    "name": "streampull",
    "productName": "StreamPull",
    "version": "1.2.1",
    "private": true,
    "description": "Desktop YouTube playlist downloader (yt-dlp + ffmpeg, runs on your own machine/IP).",
    "author": "StreamPull",
    "license": "MIT",
    "main": "server/electron-main.js",
    "dependencies": {
        "@vercel/analytics": "^2.0.1",
        "cors": "^2.8.5",
        "express": "^5.2.1",
        "express-rate-limit": "^7.4.1",
        "ffmpeg-static": "^5.3.0",
        "helmet": "^8.0.0",
        "socket.io": "^4.8.1"
    },
    "scripts": {
        "postinstall": "electron-builder install-app-deps",
        "app": "electron .",
        "app:dev": "concurrently -k -s first -n SERVER,CLIENT \"npm --prefix server run dev\" \"wait-on tcp:3000 && npm --prefix client run dev\"",
        "build:client": "npm --prefix client run build",
        "download-ytdlp": "node scripts/download-ytdlp.js",
        "prepare-desktop": "npm run build:client && npm run download-ytdlp",
        "dist": "npm run prepare-desktop && electron-builder",
        "dist:linux": "npm run prepare-desktop && electron-builder --linux",
        "dist:win": "npm run prepare-desktop && electron-builder --win",
        "dist:mac": "npm run prepare-desktop && electron-builder --mac"
    },
    "devDependencies": {
        "concurrently": "^9.1.2",
        "electron": "^33.3.1",
        "electron-builder": "^25.1.8",
        "wait-on": "^8.0.2"
    },
    "build": {
        "appId": "com.streampull.desktop",
        "productName": "StreamPull",
        "copyright": "Copyright © 2026 StreamPull",
        "asar": false,
        "directories": {
            "output": "release/${version}",
            "buildResources": "build"
        },
        "files": [
            "server/**/*",
            "client/dist/**/*",
            "!server/downloads/**/*",
            "!server/.appdata/**/*",
            "!server/.env",
            "!server/.env.*",
            "!server/cookies.txt",
            "!server/tests/**/*",
            "!server/**/*.prev",
            "!server/**/*.download",
            "!server/**/*.map"
        ],
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "category": "Utility",
            "synopsis": "Download YouTube videos and playlists locally",
            "maintainer": "StreamPull"
        },
        "appImage": {
            "artifactName": "${productName}-${arch}.AppImage"
        },
        "deb": {
            "artifactName": "${productName}-${arch}.deb",
            "afterInstall": "build/linux/postinst.sh"
        },
        "win": {
            "target": [
                "nsis"
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "artifactName": "${productName}-Setup.${ext}"
        },
        "mac": {
            "target": [
                "dmg"
            ],
            "category": "public.app-category.utilities",
            "artifactName": "${productName}-${arch}.${ext}"
        }
    }
}
